{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(docker *)",
      "Bash(make *)",
      "Bash(poetry *)",
      "Bash(bun *)",
      "Bash(npm *)",
      "WebFetch(domain:vitest.dev)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir'); branch=$(cd \"$cwd\" 2>/dev/null && git branch --show-current 2>/dev/null || echo 'no-git'); printf '\\033[36m%s\\033[0m on \\033[32m%s\\033[0m' \"$(basename \"$cwd\")\" \"$branch\""
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "playwright@claude-plugins-official": true
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "voiceEnabled": true,
  "agentPushNotifEnabled": true
}
