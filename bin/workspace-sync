#!/usr/bin/env bash
# workspace-sync — auto-sync my-workspace repo.
# Pulls with rebase, auto-commits local changes, pushes.
# On conflict, alerts via macOS notification + terminal motd.
#
# Usage:
#   workspace-sync              # run once
#   workspace-sync --status     # show current sync state
#   workspace-sync --install    # install as background service
#   workspace-sync --uninstall  # remove background service

set -euo pipefail

REPO_DIR="${WORKSPACE_SYNC_REPO:-$HOME/source/my-workspace}"
ALERT_FILE="$HOME/.workspace-sync-conflict"
LOG_FILE="$HOME/.workspace-sync.log"
HOSTNAME="$(hostname -s)"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"; }

notify() {
  local title="$1" msg="$2"
  log "$title: $msg"

  if [[ "$(uname)" == "Darwin" ]]; then
    osascript -e "display notification \"$msg\" with title \"$title\"" 2>/dev/null || true
  elif command -v notify-send &>/dev/null; then
    notify-send "$title" "$msg" 2>/dev/null || true
  fi
}

# Write conflict alert file — picked up by shell hook on next terminal open
set_conflict() {
  local msg="$1"
  cat > "$ALERT_FILE" << EOF
$msg
Detected: $(date '+%Y-%m-%d %H:%M:%S')
Repo: $REPO_DIR
Run: cd $REPO_DIR && git status
EOF
  notify "workspace-sync: conflict" "$msg"
}

clear_conflict() {
  rm -f "$ALERT_FILE"
}

# ── Status mode ───────────────────────────────────────────────────────────────

case "${1:-}" in
  --status)
    echo "Repo:     $REPO_DIR"
    echo "Log:      $LOG_FILE"
    if [[ -f "$ALERT_FILE" ]]; then
      echo "Status:   CONFLICT"
      echo ""
      cat "$ALERT_FILE"
    else
      echo "Status:   OK"
    fi
    if [[ "$(uname)" == "Darwin" ]]; then
      if launchctl print "gui/$(id -u)/com.workspace-sync" &>/dev/null; then
        echo "Service:  running (launchd)"
      else
        echo "Service:  not installed"
      fi
    else
      if systemctl --user is-active workspace-sync.timer &>/dev/null; then
        echo "Service:  running (systemd)"
      else
        echo "Service:  not installed"
      fi
    fi
    if [[ -f "$LOG_FILE" ]]; then
      echo ""
      echo "Recent log:"
      tail -5 "$LOG_FILE"
    fi
    exit 0
    ;;

  --install)
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ "$(uname)" == "Darwin" ]]; then
      launchctl bootout "gui/$(id -u)/com.workspace-sync" 2>/dev/null || true
      sed "s|\$HOME|$HOME|g" "$SCRIPT_DIR/com.workspace-sync.plist" \
        > "$HOME/Library/LaunchAgents/com.workspace-sync.plist"
      launchctl bootstrap "gui/$(id -u)" "$HOME/Library/LaunchAgents/com.workspace-sync.plist"
      echo "✓ Installed launchd service (syncs every 15 min)"
    else
      mkdir -p "$HOME/.config/systemd/user"
      cp "$SCRIPT_DIR/workspace-sync.service" "$HOME/.config/systemd/user/"
      cp "$SCRIPT_DIR/workspace-sync.timer" "$HOME/.config/systemd/user/"
      systemctl --user daemon-reload
      systemctl --user enable --now workspace-sync.timer
      echo "✓ Installed systemd timer (syncs every 15 min)"
    fi
    echo "  Check status: workspace-sync --status"
    echo "  View log:     tail ~/.workspace-sync.log"
    exit 0
    ;;

  --uninstall)
    if [[ "$(uname)" == "Darwin" ]]; then
      launchctl bootout "gui/$(id -u)/com.workspace-sync" 2>/dev/null || true
      rm -f "$HOME/Library/LaunchAgents/com.workspace-sync.plist"
      echo "✓ Removed launchd service"
    else
      systemctl --user disable --now workspace-sync.timer 2>/dev/null || true
      rm -f "$HOME/.config/systemd/user/workspace-sync.service"
      rm -f "$HOME/.config/systemd/user/workspace-sync.timer"
      systemctl --user daemon-reload
      echo "✓ Removed systemd timer"
    fi
    exit 0
    ;;

  --help|-h)
    echo "Usage: workspace-sync [--install|--uninstall|--status|--help]"
    echo "  (no args)     Run sync once"
    echo "  --install     Install as background service (every 15 min)"
    echo "  --uninstall   Remove background service"
    echo "  --status      Show sync state and service status"
    exit 0
    ;;
esac

# ── Preflight ─────────────────────────────────────────────────────────────────

if [[ ! -d "$REPO_DIR/.git" ]]; then
  log "ERROR: $REPO_DIR is not a git repo"
  exit 1
fi

cd "$REPO_DIR"

# Don't run if a rebase is already in progress
if [[ -d .git/rebase-merge || -d .git/rebase-apply ]]; then
  log "SKIP: rebase already in progress"
  set_conflict "Rebase in progress — resolve manually"
  exit 1
fi

# Need network access
if ! git ls-remote --exit-code origin &>/dev/null 2>&1; then
  log "SKIP: cannot reach remote"
  exit 0
fi

# ── Auto-commit local changes ────────────────────────────────────────────────

if [[ -n "$(git status --porcelain)" ]]; then
  git add -A
  git commit -m "auto-sync from $HOSTNAME ($(date '+%Y-%m-%d %H:%M'))" --no-gpg-sign 2>/dev/null
  log "Committed local changes"
fi

# ── Pull with rebase ─────────────────────────────────────────────────────────

pull_output="$(git pull --rebase origin main 2>&1)" || {
  # Rebase failed — conflict
  log "CONFLICT during pull: $pull_output"
  git rebase --abort 2>/dev/null || true
  set_conflict "Merge conflict during pull — run 'cd $REPO_DIR && git pull --rebase' to resolve"
  exit 1
}

log "Pull OK: $(echo "$pull_output" | tail -1)"

# Clear any previous conflict alert on successful pull
clear_conflict

# ── Push ──────────────────────────────────────────────────────────────────────

if git status -sb | grep -q "ahead"; then
  push_output="$(git push origin main 2>&1)" || {
    log "PUSH FAILED: $push_output"
    notify "workspace-sync" "Push failed — check $LOG_FILE"
    exit 1
  }
  log "Pushed to origin"
fi

log "Sync complete"
